# ============================================================================
# SkyOps Configuration Environment Variables (.env.example)
# Supports Mode A (Hosted Cloud) and Mode B (Self-Hosted Production)
# ============================================================================

# --- Core Platform Deployment Mode ---
# Options: "self_hosted" | "cloud" (defaults to "cloud" when Firebase project is present)
SKYOPS_DEPLOYMENT_MODE=self_hosted

# Primary Persistence Provider: "postgres" | "firestore" | "memory"
PERSISTENCE_PROVIDER=postgres

# Primary Authentication Mode: "local" | "firebase"
AUTH_PROVIDER=local

# Public Server URL & Host Binding
SKYOPS_SERVER_URL=https://skyops.yourdomain.com
PORT=3000
CORS_ORIGINS=https://skyops.yourdomain.com

# --- Mode B: Self-Hosted PostgreSQL Database ---
# Standard connection string format (takes precedence over individual keys):
DATABASE_URL=postgres://skyops:replace_with_strong_password@localhost:5432/skyops

# Alternatively, configure connection parameters individually:
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=skyops
POSTGRES_PASSWORD=replace_with_strong_password
POSTGRES_DB=skyops
POSTGRES_POOL_MAX=20
POSTGRES_SSL=false

# --- Mode B: Self-Hosted Local Authentication ---
# Cryptographically random secret used to sign session JWTs (generate with: openssl rand -hex 32)
SKYOPS_JWT_SECRET=replace_with_32_byte_random_hex_string

# Allow development persona demo tokens (must be false in production)
SKYOPS_ALLOW_DEMO_AUTH=false

# --- Mode B: Persistent Local Storage (Artifacts & Crash Dumps) ---
# Driver: "local" | "cloud_storage" | "memory"
STORAGE_DRIVER=local
SKYOPS_DATA_DIR=/var/lib/skyops/data
SKYOPS_STORAGE_DIR=/var/lib/skyops/data/artifacts

# --- Telemetry Ingestion & Data Retention ---
SKYOPS_TELEMETRY_STALE_SECONDS=60
SKYOPS_LOG_RETENTION_DAYS=30
SKYOPS_LOG_LEVEL=info

# --- SMTP Email Notifications (Optional in Self-Hosted) ---
SKYOPS_SMTP_HOST=smtp.mailgun.org
SKYOPS_SMTP_PORT=587
SKYOPS_SMTP_USER=postmaster@yourdomain.com
SKYOPS_SMTP_PASS=smtp_password
SKYOPS_SMTP_SECURE=false
SKYOPS_NOTIFICATION_SENDER_EMAIL=alerts@skyops.yourdomain.com
SKYOPS_NOTIFICATION_SENDER_NAME="SkyOps Incident Command"

# --- Optional AI Root-Cause Intelligence ---
# Gemini API Key (optional - system falls back to rule-based heuristics if omitted)
GEMINI_API_KEY=
# Local Ollama Host (optional, e.g. http://localhost:11434)
OLLAMA_HOST=

# ============================================================================
# Mode A: Hosted Deployment (Firebase, Firestore & GCP Cloud Storage)
# Required ONLY when running in hosted cloud mode (SKYOPS_DEPLOYMENT_MODE=cloud)
# ============================================================================
FIREBASE_PROJECT_ID=skyops-a1143
FIREBASE_STORAGE_BUCKET=skyops-a1143.firebasestorage.app
FIREBASE_TRUSTED_PROJECT_IDS=skyops-a1143,ai-studio-skyopsnetes-4a761b81-84c9-4610-bae6-624468cf7a67
SKYOPS_FIRESTORE_PROJECT_ID=skyops-a1143
SKYOPS_FIRESTORE_DATABASE_ID=ai-studio-skyopsnetes-4a761b81-84c9-4610-bae6-624468cf7a67

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=skyops-a1143.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=skyops-a1143
VITE_FIREBASE_STORAGE_BUCKET=skyops-a1143.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=ai-studio-skyopsnetes-4a761b81-84c9-4610-bae6-624468cf7a67

# Optional Cloud SaaS Billing (Razorpay)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
VITE_RAZORPAY_KEY_ID=
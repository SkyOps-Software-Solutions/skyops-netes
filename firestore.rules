rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }

    match /system_health/{docId} {
      allow read, write: if true;
    }

    match /users/{userId} {
      allow read, write: if true;
    }

    match /userNotificationSettings/{userId} {
      allow read, write: if true;
    }

    match /organizations/{orgId} {
      allow read, write: if true;
    }

    match /memberships/{membershipId} {
      allow read, write: if true;
    }

    match /organizations/{orgId}/members/{memberId} {
      allow read, write: if true;
    }

    match /invitations/{invitationId} {
      allow read, write: if true;
    }

    match /clusters/{clusterId} {
      allow read, write: if true;
    }

    match /clusterTokens/{tokenHash} {
      allow read, write: if true;
    }

    match /clusterResources/{clusterId} {
      allow read, write: if true;
    }

    match /incidents/{incidentId} {
      allow read, write: if true;
    }

    match /incidentTimeline/{eventId} {
      allow read, write: if true;
    }

    match /incidentNotes/{noteId} {
      allow read, write: if true;
    }

    match /remediations/{incidentId} {
      allow read, write: if true;
    }

    match /remediationActions/{actionId} {
      allow read, write: if true;
    }

    match /aiAnalyses/{incidentId} {
      allow read, write: if true;
    }

    match /policies/{policyId} {
      allow read, write: if true;
    }

    match /webhooks/{webhookId} {
      allow read, write: if true;
    }

    match /webhookDeliveries/{deliveryId} {
      allow read, write: if true;
    }

    match /subscriptions/{orgId} {
      allow read, write: if true;
    }

    match /invoices/{invoiceId} {
      allow read, write: if true;
    }

    match /usage/{usageId} {
      allow read, write: if true;
    }

    match /supportTickets/{ticketId} {
      allow read, write: if true;
    }

    match /auditEvents/{eventId} {
      allow read, write: if true;
    }

    match /storedArtifacts/{artifactId} {
      allow read, write: if true;
    }
  }
}



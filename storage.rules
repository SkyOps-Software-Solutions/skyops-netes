rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Global Default Deny
    match /{allPaths=**} {
      allow read, write: if false;
    }

    // Artifact access is API-mediated.  A Firebase authentication token alone
    // does not establish SkyOps organization membership, so granting direct
    // client access here would permit cross-tenant object reads/writes.  The
    // backend validates membership, RBAC, artifact ownership and path before
    // using its service identity to access this tenant-scoped namespace.
    match /tenants/{orgId}/{category}/{subpath=**} {
      allow read, write: if false;
    }
  }
}
